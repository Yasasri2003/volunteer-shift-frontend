# Optional — only needed if you want the "Continue with Google" button to work.
# Get this from https://console.cloud.google.com/apis/credentials
# (see backend/.env.example for the full step-by-step).
# Leave blank/missing and the Google button just won't render — everything
# else in the app works fine without it.
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
